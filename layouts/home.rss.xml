{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $posts := (where site.RegularPages "Section" "blog") }}
{{- $limit := site.Config.Services.RSS.Limit }}
{{- if ge $limit 1 }}
    {{- $pages = $pages | first $limit }}
{{- end }}
{{- $feedlink := "N/A" }}
{{- with .OutputFormats.Get "RSS" }}{{ $feedlink = .Permalink }}{{ end }}
{{- $feedtitle := printf "Posts &#x2022; %s" site.Title }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
    <channel>
        <title>{{ $feedtitle | safeHTML }}</title>
        <link>{{ site.Home.Permalink }}</link>
        <description>{{ site.Home.Description }}</description>
        <language>{{ site.Language.Locale }}</language>
        <copyright>{{ site.Copyright }}</copyright>
        <managingEditor>{{ site.Params.editor.email }} ({{ .Site.Params.editor.name }})</managingEditor>
        <webMaster>{{ site.Params.webmaster.email }} ({{ .Site.Params.webmaster.name }})</webMaster>
        <lastBuildDate>{{ (index $posts.ByLastmod.Reverse 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
        <generator>Hugo</generator>
        <docs>https://www.rssboard.org/rss-specification</docs>
        <image>
            <url>{{- with resources.Get "images/favicon-96x96.png" -}}{{- .Permalink }}{{- end }}</url>
            <title>{{ $feedtitle | safeHTML }}</title>
            <link>{{ site.Home.Permalink }}</link>
            <width>96</width>
            <height>96</height>
        </image>
        <atom:link href="{{ $feedlink }}" rel="self" type="application/rss+xml" />
        {{- range $posts }}
        <item>
            <title>{{ .Title }}</title>
            <link>{{ .Permalink }}</link>
            <description>{{ .Description }}</description>
            <author>{{ with .Params.author }}{{ .email }} ({{ .name }}){{ else }}{{ with site.Params.author }}{{ .email }} ({{ .name }}){{ end }}{{ end }}</author>
            <guid>{{ .Permalink }}</guid>
            <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
            <source url="{{ $feedlink }}">{{ $feedtitle | safeHTML }}</source>
            <content:encoded>{{ .Content | transform.XMLEscape | safeHTML }}</content:encoded>
        </item>
        {{- end }}
    </channel>
</rss>
